  "workflows": {
    "Complete Signup": {
      "description": "Complete signup and verification process",
      "steps": [
        "Signup Form",
        "Personal Information Form",
        "Mobile Phone Verification",
        "SMS Verification Code",
        "ID Document Selection"
      ],
      "autoSubmit": false,
      "delayBetweenSteps": 500
    },
    "Quick Bill Upload": {
      "description": "Fill forms for quick bill upload",
      "steps": [
        "Upload Bill Form",
        "Bill Details (Manual Entry)"
      ],
      "autoSubmit": false,
      "delayBetweenSteps": 300
    }
  },
  "options": {
    "delayBetweenFields": 50,
    "scrollToField": true,
    "highlightField": true,
    "confirmBeforeSubmit": false,
    "debugMode": false,
    "autoDetectCountry": true,
    "retryFailedFields": true,
    "maxRetries": 3
  },
  "notes": [
    "This is an example configuration for demonstration purposes",
    "Replace placeholder values with actual test data for your application",
    "File upload fields cannot be auto-filled and require manual selection",
    "Some fields may appear conditionally based on country or region",
    "Use {timestamp} placeholder for dynamic generation",
    "Use {randomN} placeholder for any number of random digits (e.g., {random5}, {random2})",
    "Use {randomN-[exclusions]} to exclude specific digits (e.g., {random3-[1,5]} for 3 digits excluding 1 and 5)",
    "Use {streetName} and {streetType} for random address components",
    "Use {postcodeAU} and {postcodeUS} for region-specific postcodes",
    "Use {random6} placeholder for unique 6-digit values",
    "Test card numbers are publicly available test values"
  ]
}
