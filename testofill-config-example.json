{
  "name": "Testofill Configuration Example",
  "version": "1.0.0",
  "description": "Example configuration for Testofill form auto-filling",
  "environments": {
    "example": {
      "us": "https://example-us.app.com/",
      "au": "https://example-au.app.com/"
    }
