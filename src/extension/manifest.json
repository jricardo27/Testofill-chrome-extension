{
  "name": "AutoFormFiller",
  "version": "2.0.1",
  "manifest_version": 3,
  "author": "Jakub Holy <https://holyjak.cz/>",
  "icons": {
    "16": "autoformfiller_icon.png",
    "128": "autoformfiller_icon.png"
  },
  "description": "Enable testers to fill forms automatically/on-demand based on (sets of) rules they wrote / captured.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "optional_permissions": [],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://holyjak.cz/*"
      ],
      "js": [
        "content/lib/sizzle-20140125.min.js",
        "content/lib/underscore-min.js",
        "content/lib/chance.min.js",
        "content/generative.js",
        "content/testofill-run.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "AutoFormFiller",
    "default_icon": {
      "16": "autoformfiller_icon.png",
      "128": "autoformfiller_icon.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}